{
  "id": "makework-dark",
  "name": "MakeWork Dark",
  "author": "MakeWork",
  "scheme": "dark",
  "colors": {
    "accent": "#2f78e4",
    "accentText": "#000000",
    "text": "#ecf6ff",
    "textMuted": "#acbdcd",
    "textDisabled": "#a1a9b1",
    "border": "#3d52ae",
    "link": "#24daff",
    "warning": "#e44b2e",
    "success": "#4ce1a0",
    "danger": "#e53935",
    "light": "#0b0e28",

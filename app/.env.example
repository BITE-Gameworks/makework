# Optional: copy to .env.local to use other Google OAuth clients than the built-in ones (src/core/google.ts).
# Web application client: authorized redirect URI http://localhost:1420/google-callback.html
VITE_GOOGLE_WEB_CLIENT_ID=
# Desktop app client (Electron, loopback redirect). Release builds get the secret from the repository secret
# GOOGLE_DESKTOP_CLIENT_SECRET; without one, the desktop app offers no Google sign-in.
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=
# Optional: TURN credentials worker (turn-worker/) to use instead of the built-in one (src/p2p/ice.ts).
VITE_TURN_URL=
# Optional: default user server (user-server/) instead of me.makework.dev (src/core/userServer.ts).
VITE_USER_SERVER_URL=
# Optional: GitHub OAuth app (with Device Flow enabled) for signing in to repositories, instead of the user
# server's (src/core/githubAuth.ts).
VITE_GITHUB_CLIENT_ID=
